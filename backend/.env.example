APP_NAME=Project Management API
DEBUG=false
API_V1_PREFIX=/api/v1

# Local (uvicorn on the host). Docker Compose overrides these to use host `db`.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/project_management
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/project_management
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/project_management_test

# Generate a long random value before deploying.
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Set COOKIE_SECURE=true behind HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
COOKIE_NAME=refresh_token

# Keep replica_count * (pool_size + max_overflow) well under Postgres max_connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Redis (shared by caching and background jobs)
REDIS_URL=redis://localhost:6379/0
